generator client {
  provider = "prisma-client-js"
  // output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
  // provider = "mysql"
  // url      = env("DATABASE_URL")
}


model Costumer {
  id      Int      @id @default(autoincrement())
  email   String   @unique
  password    String
  firstName    String?
  lastName    String?
  username String?
  avatar  String?
  role    String
}

model Staff {
  id            String     @id @default(uuid())
  name          String
  image         String? 
  email         String?
  phone         String?
  position      String?
  experience    String?
  department    Department?     // Enum will be defined separately
  salary        Float?
  hireDate      String?
  status        Status?     // Enum will be defined separately
  bio           String?
  schedule      Json?       // Storing the complex schedule structure as JSON
  performance   Json?       // Storing performance data as JSON
  specialties   String?
  certifications String?
  awards        String?
  notes         String?

}

model Dish {
  id            String    @id  @default(uuid()) 
  name          String    
  description   String?    
  price         Float?    
  image         String?    
  category      String?    
  rating        Float?    
  cookTime      String?    
  isVegetarian  Boolean?    
  isSpicy       Boolean?    

}
// model Contact {
//   id            String      @id
//   email         String
//   phone         String

//   Staff Staff[]
// }
enum Department {
  Kitchen
  Front_of_House
  Management
}

enum Status {
  active
  inactive
  on_leave
}